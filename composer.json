{
  "name": "mgemmel/nette-dto-serializer",
  "description": "DTO-based API serializer with support for includes, nesting and Nette integration.",
  "type": "library",
  "require": {
    "php": ">=8.3"
  },

  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan-strict-rules": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "NetteDtoSerializer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NetteDtoSerializer\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "license": "MIT",
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": false
    }
  }
}
